# Copy to /opt/ewbot/.env (the installer does this) and fill in. Never commit the real .env!
# Crypto.com Exchange API key: permissions "Trade" (Spot) only, NO withdrawal, IP whitelist = VPS IP.
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=
# Telegram (optional): token from @BotFather, chat id e.g. from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
